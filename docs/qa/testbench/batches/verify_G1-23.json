      "esperado": "reproducir: se ignora el path fantasma en silencio"
    },
    {
      "id": "G1-23-v2-solo-fantasma",
      "tool": "knowledge_check",
      "arguments": {
        "scope": {
          "kind": "paths",
          "paths": ["no-existe.md"]
        }
      },
      "esperado": "control: ¿scope 100% inexistente da error o valid:true vacio?"
